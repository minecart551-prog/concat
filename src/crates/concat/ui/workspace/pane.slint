import { Theme } from "../theme/theme.slint";
import { ThinScrollbar } from "../primitives/scrollbar.slint";
import { Payload } from "../util.slint";

// The workspace shell: one of the four resizable regions the editor is built
// out of, as opposed to `Panel` in primitives/, which is the floating
// inspector card that lives *inside* a pane.
//
// A pane is a rounded surface that takes whatever box the workspace hands it,
// so nothing in here may set a width or a height — every size is inherited
// from the parent and every child stretches to fill it.
export component Pane inherits Rectangle {
    /// A hairline all the way round. Off by default: the panes float on a
    /// ground several stops darker than they are, so the gutters already draw
    /// every edge — and an outline on top of that reads as a box around
    /// something rather than as the edge of a surface. What is left where a
    /// pane does need an edge is a single rule on the one side that needs it,
    /// which is what the timeline does across its top.
    in property <bool> outlined: false;

    background: Theme.panel;
    border-width: root.outlined ? 1px : 0px;
    border-color: Theme.line;
    border-radius: Theme.r-lg;
    // Rounded corners only cut the pane's own fill; the body has to be clipped
    // to them as well or a full-bleed child squares them off again.
    clip: true;

    VerticalLayout {
        @children
    }
}

// The patch of a pane's header that picks the whole panel up by: press it,
// drag onto another panel, and the two trade places — or the one landed on is
// split in two. The same drop the corner button has always offered, from a
// target the size of the header instead of the size of a button.
//
// Nothing drawn at rest: a header that wears a grip strip is a header with
// less room in it, and the cursor is the sign. On the pointer it lifts a
// wash, and while in the air the source fades, as a bin card or a timeline
// tab does.
//
// `Payload` is spelled the same as the corner button's, so a seat cannot tell
// the two drag sources apart — one payload vocabulary, one drop rule.
export component PaneGrip inherits Rectangle {
    /// The `pane:<seat>:<name>:<slug>` payload a drag from here hands the
    /// seat it lands on. Empty is not a grip: a pane in a pop-out window has
    /// no seats around it to trade with.
    in property <string> payload;

    border-radius: Theme.r-sm;
    background: touch.has-hover || drag.dragging ? Theme.field-hover : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    drag := DragArea {
        allow-move: true;
        data: Payload.of(root.payload);
        drag-image: Payload.preview(root.payload);
        drag-image-offset-x: -8;
        drag-image-offset-y: -4;

        // A TouchArea over the drag for the cursor alone: DragArea takes the
        // press past a threshold and leaves every click it did not travel
        // for, so nothing is lost by the one under it.
        touch := TouchArea {
            mouse-cursor: drag.dragging ? MouseCursor.grabbing : MouseCursor.grab;
        }
    }
}

// Pane title bar. `@children` are the trailing actions, the same contract
// PanelHeader uses.
export component PaneHeader inherits Rectangle {
    in property <string> title;
    /// The payload a drag from this header's empty stretch carries, from
    /// `Panes.payload(seat, kind)`. Empty leaves the stretch plain — which
    /// is what a bare pane wants, having no seat around it to trade with.
    in property <string> grip-payload: "";

    // 52px, which is the library pane's tab strip — the tallest of the three
    // top bars, because that one has a row of chips in it and the other two
    // have a line of text. One height across all three is worth more than
    // each pane's own minimum: the three panes sit side by side, and a header
    // that steps down twice across the top of the window reads as three
    // panels bolted together rather than as one shell.
    height: 52px;

    // Hairline on the bottom edge rather than a border on the body, so the
    // line runs the full width of the pane and not the width of the content.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: root.title;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
            vertical-alignment: center;
        }

        // The stretch, and the grip when there is one: the same box, which
        // is the point — the emptiest part of the header is the part nobody
        // needs, and so the part a panel is best picked up by.
        if root.grip-payload == "": Rectangle { horizontal-stretch: 1; }
        if root.grip-payload != "": PaneGrip {
            payload: root.grip-payload;
            horizontal-stretch: 1;
        }

        HorizontalLayout {
            spacing: 2px;
            @children
        }
    }
}

// Everything below the header. Carries the stretch factor that makes the pane
// body — and not the header — absorb the space a drag adds or takes away.
export component PaneBody inherits VerticalLayout {
    vertical-stretch: 1;
    padding: 10px;
    spacing: 8px;

    @children
}

// A wheel-scrolled body for panes whose content is taller than the pane.
//
// Not a Flickable: a Flickable claims any drag that crosses its threshold, and
// the inspector is full of controls that are themselves dragged — a number
// field scrubbed sideways, a knob, a bezier handle. Losing those gestures to
// the scroller is worse than losing kinetic scrolling, and a wheel is what a
// desktop editor is driven with anyway.
export component PaneScroll inherits Rectangle {
    /// A finger drags the column as well: a press that no control took -
    /// on a label, a note, a heading, the air between rows - scrolls. Not
    /// a Flickable, which would take the drag off a control as well; a
    /// finger has no wheel, and this is the sheet a phone reads its
    /// Settings in.
    in property <bool> finger;

    // The offset is clamped on read rather than only on write, so a pane that
    // shrinks under the content — or content that gets shorter — cannot leave
    // the viewport parked past the end.
    property <length> overflow: Math.max(0px, content.preferred-height - root.height);
    property <length> offset;
    property <length> at: Math.max(-root.overflow, Math.min(0px, root.offset));
    /// Where the column was when the finger landed, and where the finger did.
    property <length> press-at;
    property <length> press-y;

    clip: true;

    wheel := TouchArea {
        // A scroll the inner controls do not handle bubbles up to here; this
        // is an ancestor of the content, not a sibling, which is what makes
        // that work.
        scroll-event(event) => {
            root.offset = root.at + event.delta-y;
            return EventResult.accept;
        }
        pointer-event(event) => {
            if (root.finger && event.kind == PointerEventKind.down) {
                root.press-at = root.at;
                root.press-y = self.mouse-y;
            }
        }
        moved => {
            if (root.finger && self.pressed) {
                root.offset = root.press-at + (self.mouse-y - root.press-y);
            }
        }

        content := VerticalLayout {
            y: root.at;
            height: self.preferred-height;

            @children
        }
    }

    // The same bar the track stack uses, rather than a second hand-rolled one
    // a pixel narrower. This offset runs negative — the content is moved up to
    // scroll down — so it is flipped on the way in and back on the way out.
    ThinScrollbar {
        x: parent.width - self.width - 1px;
        y: 0;
        height: root.height;
        viewport: root.height;
        content: root.height + root.overflow;
        offset: -root.at;
        scrolled(to) => { root.offset = -to; }
    }
}
